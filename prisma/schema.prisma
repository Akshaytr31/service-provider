generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id                    Int               @id @default(autoincrement())
  name                  String?           @db.VarChar(255)
  email                 String?           @unique @db.VarChar(255)
  image                 String?           @db.Text
  role                  String            @default("seeker") @db.VarChar(20)
  providerRequestStatus String            @default("none") @db.VarChar(20)
  isProviderAtFirst     Boolean           @default(false)
  password              String?           @db.VarChar(255)
  mobile                String?           @db.VarChar(20)
  createdAt             DateTime          @default(now()) @db.Timestamp(0)
  dateOfBirth           String?           @db.VarChar(50)
  languages             String?           @db.Text
  otp                   String?           @db.VarChar(10)
  otpExpiry             DateTime?
  email_verified        Boolean           @default(false)
  seekerProfile         SeekerProfile?
  providerRequests      ProviderRequest[]

  @@map("users")
}

model EmailOtp {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  otp       String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("email_otps")
}

model services {
  id            Int         @id @default(autoincrement())
  providerEmail String      @db.VarChar(255)
  title         String      @db.VarChar(255)
  description   String      @db.Text
  location      String?     @db.VarChar(255)
  price         String?     @db.VarChar(100)
  createdAt     DateTime    @default(now()) @db.Timestamp(0)
  subCategoryId Int         @map("sub_category_id")
  coverPhoto    String?     @db.Text
  serviceRadius Int?        @map("service_radius")
  servicesOffered Json?     @map("services_offered")
  status        String      @default("ACTIVE") @db.VarChar(20)
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])
   
  @@index([subCategoryId], map: "services_sub_category_id_fkey")
  @@map("services")
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(255)
  image         String?       @db.Text
  subCategories SubCategory[]

  @@map("categories")
}

model SubCategory {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(255)
  categoryId Int        @map("category_id")
  services   services[]
  category   Category   @relation(fields: [categoryId], references: [id])

  @@index([categoryId], map: "sub_categories_category_id_fkey")
  @@map("sub_categories")
}

model ProviderRequest {
  id                 Int                      @id @default(autoincrement())
  userId             Int                      @map("user_id")
  profilePhoto       String?                  @map("profile_photo") @db.Text
  status             provider_requests_status @default(PENDING)
  createdAt          DateTime                 @default(now()) @map("created_at")
  subCategoryId      Int?                     @map("sub_category_id")
  address            String?                  @db.Text
  availability       Json?
  backgroundCheck    Boolean                  @default(false) @map("background_check_consent")
  baseRate           String?                  @map("base_rate") @db.VarChar(100)
  businessName       String?                  @map("business_name") @db.VarChar(255)
  businessType       String?                  @map("business_type") @db.VarChar(50)
  city               String?                  @db.VarChar(100)
  companyLogo        String?                  @map("company_logo") @db.Text
  contactMethod      String?                  @map("contact_method") @db.VarChar(50)
  country            String?                  @db.VarChar(100)
  dateOfBirth        String?                  @map("date_of_birth") @db.VarChar(50)
  description        String?                  @db.Text
  establishmentYear  String?                  @map("establishment_year") @db.VarChar(4)
  gender             String?                  @db.VarChar(20)
  idNumber           String?                  @map("id_number") @db.VarChar(100)
  idProofUrl         String?                  @map("id_proof_url") @db.Text
  idType             String?                  @map("id_type") @db.VarChar(50)
  licenses           Json?
  onSiteCharges      String?                  @map("on_site_charges") @db.VarChar(100)
  paymentMethods     Json?                    @map("payment_methods")
  pricingType        String?                  @map("pricing_type") @db.VarChar(50)
  privacyAccepted    Boolean                  @default(false) @map("privacy_accepted")
  qualifications     Json?
  registrationNumber String?                  @map("registration_number") @db.VarChar(100)
  rulesAccepted      Boolean                  @default(false) @map("rules_accepted")
  serviceAreas       Json?                    @map("service_areas")
  serviceRadius      Int?                     @map("service_radius")
  servicesOffered    Json?                    @map("services_offered")
  state              String?                  @db.VarChar(100)
  termsAccepted      Boolean                  @default(false) @map("terms_accepted")
  yearsExperience    String?                  @map("years_experience") @db.VarChar(50)
  zipCode            String?                  @map("zip_code") @db.VarChar(20)
  latitude           Float?                   @map("latitude")
  longitude          Float?                   @map("longitude")
  firstName          String?                  @map("first_name") @db.VarChar(255)
  lastName           String?                  @map("last_name") @db.VarChar(255)
  userType           String?                  @map("user_type") @db.VarChar(20)
  businessExpiryDate String?                  @map("business_expiry_date") @db.VarChar(50)
  rejectionReason    String?                  @map("rejection_reason") @db.Text
  trnNumber          String?                  @map("trn_number") @db.VarChar(100)
  categoryId         Int?                     @map("category_id")
  clarifications     Clarification[]
  user               users                    @relation(fields: [userId], references: [id])

  @@index([userId], map: "provider_requests_user_id_fkey")
  @@map("provider_requests")
}

model SeekerProfile {
  id                         Int      @id @default(autoincrement())
  userId                     Int      @unique
  userType                   String
  firstName                  String?
  lastName                   String?
  idType                     String?
  idNumber                   String?
  backgroundCheck            Boolean  @default(false)
  qualifications             Json?
  gender                     String?
  address                    String?
  createdAt                  DateTime @default(now())
  businessExpiryDate         String?
  businessName               String?
  businessType               String?
  establishmentYear          String?
  registrationNumber         String?
  trnNumber                  String?
  acceptedTermsandconditions Boolean  @default(false)
  fieldOfStudy               String?
  institution                String?
  year                       String?
  city                       String?
  country                    String?
  state                      String?
  zipCode                    String?
  user                       users    @relation(fields: [userId], references: [id])
}

model PrivacyPolicy {
  id        Int      @id @default(1)
  content   String   @db.LongText
  updatedAt DateTime @updatedAt

  @@map("privacy_policy")
}

enum provider_requests_status {
  PENDING
  APPROVED
  REJECTED
}

model Clarification {
  id                Int             @id @default(autoincrement())
  providerRequestId Int             @map("provider_request_id")
  message           String          @db.Text
  sender            String          @db.VarChar(50)
  createdAt         DateTime        @default(now()) @map("created_at")
  providerRequest   ProviderRequest @relation(fields: [providerRequestId], references: [id])

  @@index([providerRequestId], map: "clarifications_provider_request_id_fkey")
  @@map("clarifications")
}
